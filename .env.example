# Environments and Credentials template

# GBIF API Configuration
GBIF_API_URL=https://api.gbif.org/v1/occurrence/search

# Copernicus Marine Service (CMEMS) Credentials
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password

# NASA Earthdata Credentials
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# YouTube Data API v3 key (Stage 01 social-media scraper)
# Create at https://console.cloud.google.com/ -> APIs & Services -> Credentials.
# Restrict the key to YouTube Data API v3. Put the real value in .env only.
YOUTUBE_API_KEY=
